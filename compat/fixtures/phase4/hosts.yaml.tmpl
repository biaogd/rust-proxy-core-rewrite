mixed-port: ${MIXED_PORT}
mode: rule
log-level: info
ipv6: false
hosts:
  fixed.phase4.test:
    - 192.0.2.10
    - 2001:db8::10
  alias.phase4.test: terminal.phase4.test
dns:
  enable: true
  listen: 127.0.0.1:${DNS_PORT}
  ipv6: false
  use-hosts: true
  use-system-hosts: true
  enhanced-mode: redir-host
  nameserver:
    - udp://127.0.0.1:${UPSTREAM_PORT}
rules:
  - DOMAIN,mapped.phase4.test,DIRECT
  - MATCH,REJECT
