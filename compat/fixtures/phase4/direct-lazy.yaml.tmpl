mixed-port: ${MIXED_PORT}
mode: rule
log-level: info
ipv6: false
dns:
  enable: true
  listen: 127.0.0.1:${DNS_PORT}
  ipv6: false
  use-hosts: false
  use-system-hosts: false
  enhanced-mode: redir-host
  nameserver:
    - udp://127.0.0.1:${MAIN_PORT}
  direct-nameserver:
    - tcp://127.0.0.1:${DIRECT_PORT}
  direct-nameserver-follow-policy: ${FOLLOW_POLICY}
  nameserver-policy:
    '+.follow.phase4.test': udp://127.0.0.1:${POLICY_PORT}
rules:
${RULES}
