mode: rule
log-level: info
ipv6: false
dns:
  enable: true
  listen: 127.0.0.1:${DNS_PORT}
  ipv6: false
  use-hosts: false
  use-system-hosts: false
  enhanced-mode: redir-host
  nameserver:
    - udp://127.0.0.1:${MAIN_PORT}
  fallback:
    - tcp://127.0.0.1:${FALLBACK_PORT}
  fallback-lazy-query: ${FALLBACK_LAZY}
  fallback-filter:
    geoip: false
    ipcidr:
      - 198.51.100.0/24
    domain:
      - '+.fallback.phase4.test'
  nameserver-policy:
    'policy.phase4.test': udp://127.0.0.1:${POLICY_PORT}
rules:
  - MATCH,DIRECT
