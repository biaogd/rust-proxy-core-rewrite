mode: rule
log-level: info
ipv6: false
dns:
  enable: true
  listen: 127.0.0.1:${DNS_PORT}
  ipv6: false
  use-hosts: false
  use-system-hosts: false
  enhanced-mode: redir-host
  nameserver:
    - udp://127.0.0.1:${MAIN_PORT}
  nameserver-policy:
    '+.suffix.phase4.test': udp://127.0.0.1:${SUFFIX_PORT}
    '*.one.phase4.test':
      - tcp://127.0.0.1:${WILDCARD_PORT}
    '+.overlap.phase4.test': udp://127.0.0.1:${SUFFIX_PORT}
    'exact.overlap.phase4.test': tcp://127.0.0.1:${EXACT_PORT}
rules:
  - MATCH,DIRECT
